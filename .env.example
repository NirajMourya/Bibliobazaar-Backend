# Server Configuration
PORT=8080
BASE_URL=http://localhost:8080

# Database Configuration
MONGO_CONNECT=mongodb://localhost:27017/biblio-bazaar

# JWT Configuration
TOKEN_SECRET=your_jwt_secret_key_here

# Google Books API Configuration
GOOGLE_API_KEY=your_google_api_key_here

# Razorpay Configuration (Payment Gateway)
RAZORPAY_ID=your_razorpay_key_id_here
RAZORPAY_SECRET=your_razorpay_key_secret_here

# ImageKit Configuration (Image Management)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL=your_imagekit_url_endpoint_here

# Application Environment
NODE_ENV=development
